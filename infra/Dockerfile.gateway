# The boundary gateway: the only container attached to both an edge network and
# core_net. The config is baked in rather than bind-mounted on purpose — it is a
# security control, and a control that can be swapped by editing a file on the host
# is one that can be swapped without anyone reviewing the change.
FROM nginx:1.27-alpine
COPY infra/boundary-gateway.conf /etc/nginx/conf.d/default.conf
