# Connector (per institution)
MARSAD_INSTITUTION_NAME="Al Maha Bank"
MARSAD_INSTITUTION_REF=psd_almaha01
MARSAD_SECTOR=BANK
MARSAD_SIZE_BAND=LARGE
MARSAD_CORE_URL=http://localhost:8000
MARSAD_TOKENISER=hmac
# 16+ bytes. Dev only — production uses an OPRF with HSM threshold custody.
MARSAD_TOKEN_KEY=change-me-to-a-long-random-value
MARSAD_LLM_PROVIDER=stub
# Only read when MARSAD_LLM_PROVIDER=openai_compatible. Must be an OpenAI-compatible
# root (ending /v1) served inside the perimeter: a Docker service name, localhost, a
# private IP, or an .internal/.local/.lan name. A public endpoint is refused at boot.
MARSAD_LLM_BASE_URL=http://ollama:11434/v1
MARSAD_LLM_MODEL=qwen2.5:7b-instruct
# Local servers ignore this. A hosted-vendor key (sk-, sk-ant-, AIza, gsk_, hf_) is refused.
MARSAD_LLM_API_KEY=
# Escape hatch. false lets plaintext incident text leave the institution. Not supported.
MARSAD_SOVEREIGN_MODE=true

# Core
MARSAD_CORE_SIMILARITY_ENGINE=jaccard
MARSAD_CORE_SIMILARITY_THRESHOLD=0.60
MARSAD_CORE_K_ANONYMITY=3
