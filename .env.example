# Connector (per institution)
MARSAD_INSTITUTION_NAME="Al Maha Bank"
MARSAD_INSTITUTION_REF=psd_almaha01
MARSAD_SECTOR=BANK
MARSAD_SIZE_BAND=LARGE
MARSAD_CORE_URL=http://localhost:8000
# hmac is prototype-only. oprf needs the values printed by scripts/oprf_keygen.py.
MARSAD_TOKENISER=hmac
# 16+ bytes. Only read when MARSAD_TOKENISER=hmac.
MARSAD_TOKEN_KEY=change-me-to-a-long-random-value
MARSAD_OPRF_EPOCH=1
MARSAD_OPRF_THRESHOLD=2
MARSAD_OPRF_GROUP_KEY=
MARSAD_OPRF_CUSTODIANS=[]
# Browser origins allowed to call this service. * is refused.
MARSAD_CORS_ORIGINS=http://localhost:3000
# Empty leaves the connector API open. Set it anywhere but an analyst's own machine.
MARSAD_CONSOLE_TOKEN=
MARSAD_RETENTION_PURGE_INTERVAL_SECONDS=3600
# How often to ask the core whether this firm has been matched. 0 turns it off.
MARSAD_NOTICE_POLL_INTERVAL_SECONDS=60
# Only for a connector run by an enrolled third-party provider.
MARSAD_PROVIDER_DOMAIN=
MARSAD_LLM_PROVIDER=stub
# Only read when MARSAD_LLM_PROVIDER=openai_compatible. Must be an OpenAI-compatible
# root (ending /v1) served inside the perimeter: a Docker service name, localhost, a
# private IP, or an .internal/.local/.lan name. A public endpoint is refused at boot.
MARSAD_LLM_BASE_URL=http://ollama:11434/v1
MARSAD_LLM_MODEL=qwen2.5:7b-instruct
# Local servers ignore this. A hosted-vendor key (sk-, sk-ant-, AIza, gsk_, hf_) is refused.
MARSAD_LLM_API_KEY=
# Escape hatch. false lets plaintext incident text leave the institution. Not supported.
MARSAD_SOVEREIGN_MODE=true

# Core
MARSAD_CORE_SIMILARITY_ENGINE=jaccard
MARSAD_CORE_SIMILARITY_THRESHOLD=0.60
MARSAD_CORE_K_ANONYMITY=3
MARSAD_CORE_CORS_ORIGINS=http://localhost:3000
# On in every deployment beyond one laptop. Needs the mTLS gateway in front.
MARSAD_CORE_REQUIRE_CLIENT_IDENTITY=false
MARSAD_CORE_REGISTERED_INSTITUTIONS_RAW=
# role:token,role:token where role is operator or regulator. Empty leaves reads open.
MARSAD_CORE_CONSOLE_TOKENS=
MARSAD_CORE_ANCHOR_INTERVAL_SECONDS=300
# Enrolled providers: {token: {name, service, market_activity_share, owner_ref}}.
MARSAD_CORE_PROVIDER_DIRECTORY={}
# local (reduced fidelity) or besu.
MARSAD_CORE_LEDGER_BACKEND=local
