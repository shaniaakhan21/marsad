# Connector (per institution)
MARSAD_INSTITUTION_NAME="Al Maha Bank"
MARSAD_INSTITUTION_REF=psd_almaha01
MARSAD_SECTOR=BANK
MARSAD_SIZE_BAND=LARGE
MARSAD_CORE_URL=http://localhost:8000
MARSAD_TOKENISER=hmac
# 16+ bytes. Dev only — production uses an OPRF with HSM threshold custody.
MARSAD_TOKEN_KEY=change-me-to-a-long-random-value
MARSAD_LLM_PROVIDER=stub

# Core
MARSAD_CORE_SIMILARITY_ENGINE=jaccard
MARSAD_CORE_SIMILARITY_THRESHOLD=0.60
MARSAD_CORE_K_ANONYMITY=3
