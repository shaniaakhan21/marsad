# Python
__pycache__/
*.py[cod]
.venv/
*.db
.pytest_cache/
.ruff_cache/
*.egg-info/

# Env / secrets
.env
.env.*
!.env.example

# Node / JS
node_modules/
.next/
dist/
# tsc incremental build cache — regenerated by `npm run typecheck` and by the e2e
# run, so tracking it turns every build into a spurious diff.
*.tsbuildinfo

# Misc build/runtime
var/
test-results/
playwright-report/
blob-report/

# Claude Code / AI tooling
.claude/
.claude-*
CLAUDE.local.md

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Dotfiles / local-only (catch-all; explicit allowlist below)
.*
!.gitignore
!.gitattributes
!.env.example
!.github/
!.github/**

# Deployment TLS material. The CA key signs every identity core trusts; a private key
# in version control is a private key on every machine that ever cloned the repo.
# Regenerate with deploy/make-certs.sh.
deploy/certs/
